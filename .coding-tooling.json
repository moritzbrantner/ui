{
  "schemaVersion": 1,
  "profile": "repository-foundation-v1",
  "tiers": {
    "fast": ["format:check", "lint", "typecheck", "build", "test:unit"],
    "full": ["format:check", "lint", "typecheck", "build", "test:unit", "test:integration", "package:check", "benchmark:smoke"]
  },
  "requiredCapabilities": ["format:check", "lint", "typecheck", "build", "test:unit"],
  "optionalCapabilities": ["test:integration", "package:check", "benchmark:smoke"],
  "capabilityCommands": {
    "@moritzbrantner/ui": {
      "lint": ["bash", "-lc", "bunx oxlint@1.80.0 --format=github && bun run lint"],
      "test:integration": ["bun", "run", "test:coverage"],
      "package:check": ["bash", "-lc", "bun run build && bun run test:package && bun run verify:consumer && bun run pack:dry"],
      "benchmark:smoke": ["bun", "run", "bench"]
    }
  }
}
