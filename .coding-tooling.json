{
  "schemaVersion": 1,
  "profile": "repository-foundation-v1",
  "tiers": {
    "fast": ["format:check", "lint", "typecheck", "build", "test:unit"],
    "full": [
      "format:check",
      "lint",
      "typecheck",
      "build",
      "test:unit",
      "test:integration",
      "test:e2e",
      "test:e2e:smoke",
      "test:accessibility",
      "test:visual",
      "benchmark",
      "storybook:check"
    ],
    "integration": ["test:integration"],
    "e2e": ["test:e2e", "test:e2e:smoke", "test:accessibility"],
    "performance": ["benchmark", "size:budget"]
  },
  "requiredCapabilities": ["format:check", "lint", "typecheck", "build", "test:unit"],
  "optionalCapabilities": [
    "test:integration",
    "test:e2e",
    "test:e2e:smoke",
    "test:accessibility",
    "test:visual",
    "benchmark",
    "storybook:check",
    "size:budget"
  ],
  "capabilityCommands": {
    "@moritzbrantner/ui": {
      "storybook:check": ["bun", "run", "test:storybook"],
      "test:e2e:smoke": ["bun", "run", "test:visual", "visual/editor-reference.spec.ts"],
      "test:integration": ["bun", "run", "verify:consumer:editor"]
    },
    "@moritzbrantner/ui-consumer-example": {
      "test:unit": ["bun", "run", "--cwd", "../..", "test:unit"],
      "storybook:check": ["bun", "run", "--cwd", "../..", "test:storybook"],
      "test:e2e:smoke": [
        "bun",
        "run",
        "--cwd",
        "../..",
        "test:visual",
        "visual/editor-reference.spec.ts"
      ],
      "test:integration": ["bun", "run", "--cwd", "../..", "verify:consumer:editor"]
    }
  },
  "taskKnowledge": {
    "schemaVersion": 1,
    "alwaysInstructions": ["CONTEXT.md", "docs/design-system.md"],
    "completion": {
      "command": ["bun", "run", "verify:release"],
      "source": "package.json"
    },
    "scopes": [
      {
        "id": "editor-reference",
        "paths": [
          "src/components/patterns/editor-workbench*",
          "src/components/patterns/workbench-layout*",
          "src/components/stable/numeric-input*",
          "src/components/stable/vector-input*",
          "src/components/stable/property*",
          "src/components/stable/angle-input*",
          "examples/editor-reference/**",
          "visual/editor-reference.spec.ts",
          "examples/consumer/src/main-editor.tsx",
          "visual/editor-consumer.acceptance.ts",
          ".coding-tooling/generators/editor-consumer/**",
          "visual/property-section.spec.ts"
        ],
        "taskKinds": ["presentation", "editor-adoption"],
        "instructions": ["docs/editor-ui.md", "examples/editor-reference/README.md"],
        "conventionRefs": ["MORITZUI-001", "MORITZUI-002", "UI-005", "UI-007"],
        "capabilities": ["test:unit", "storybook:check", "test:e2e:smoke", "test:integration"],
        "examples": [
          {
            "path": "examples/editor-reference/EditorReference.tsx",
            "entrypoint": "@moritzbrantner/ui"
          },
          {
            "path": "src/components/patterns/editor-workbench.stories.tsx",
            "entrypoint": "@moritzbrantner/ui/components/patterns/editor-workbench"
          },
          {
            "path": "examples/consumer/src/main-editor.tsx",
            "entrypoint": "@moritzbrantner/ui/examples/editor-reference"
          }
        ],
        "generators": ["ui-component", "editor-consumer"],
        "owners": ["moritzbrantner/ui"]
      },
      {
        "id": "size-evidence",
        "paths": [".performance/**", "scripts/*size*", "tsup.config.ts"],
        "taskKinds": ["performance", "package-size"],
        "instructions": ["docs/size-evidence.md"],
        "conventionRefs": ["BENCH-010"],
        "capabilities": ["build", "size:budget"],
        "owners": ["moritzbrantner/ui"]
      }
    ]
  }
}
