{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard", ":preserveSemverRanges"],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 1,
  "packageRules": [
    {
      "description": "Review major upgrades from the Dependency Dashboard before opening a PR.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Keep Playwright's packages in one compatibility update.",
      "groupName": "Playwright",
      "matchPackageNames": ["playwright", "@playwright/test", "@axe-core/playwright"]
    },
    {
      "description": "Keep Storybook packages aligned.",
      "groupName": "Storybook",
      "matchPackagePrefixes": ["@storybook/"]
    }
  ]
}
